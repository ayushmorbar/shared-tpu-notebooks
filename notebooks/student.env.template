WANDB_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Kaggle API Credentials
# ------------------------------------------------------------------------------
# Download your personal token from: https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=""
KAGGLE_API_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Hugging Face Hub Token (Optional)
# ------------------------------------------------------------------------------
# Generate your user access token at: https://huggingface.co/settings/tokens
HF_TOKEN=""

# ------------------------------------------------------------------------------
# 4. Custom Student Credentials & Third-Party Integrations (Optional)
# ------------------------------------------------------------------------------
# You are NOT limited to the keys above! Any environment variable you define here
# (e.g. COMET_API_KEY, NEPTUNE_API_TOKEN, OPENAI_API_KEY, CUSTOM_STUDENT_ID)
