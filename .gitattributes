# Force Unix LF line endings for all shell scripts, makefiles, python, yaml, and config files
* text=auto eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.template text eol=lf
Makefile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.txt text eol=lf
