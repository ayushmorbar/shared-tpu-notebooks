# ==============================================================================
# shared-tpu-notebooks: Centralized Environment Configuration Template
# ==============================================================================
# Copy this file to `config.env` and customize for your GCP environment:
#   cp config.env.example config.env
#
# Once config.env exists, the Makefile and all scripts will automatically load
# these values, so you can run `make cluster`, `make hub`, etc., without flags.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Core Settings (Required)
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID (e.g. my-tpu-classroom-project)
PROJECT="your-gcp-project-id"

# Target GCP region for GKE cluster and Cloud TPUs (e.g. us-west4)
REGION="us-west4"

# GKE Autopilot Cluster Name
CLUSTER="tpu-notebooks"

# Kubernetes Namespace for Course Workloads (e.g. cmu-idl)
NAMESPACE="cmu-idl"

# ------------------------------------------------------------------------------
# 2. Course Sizing & Roster Configuration
# ------------------------------------------------------------------------------
# Expected number of concurrent students in the course
STUDENTS=15

# Total Cloud TPU chips in the shared pool (e.g. 32 or 64 or 128)
POOL_CHIPS=32

# Number of TPU chips to hold warm for instant scheduling (default: 1, $1.35/hr)
WARM=1

# ------------------------------------------------------------------------------
# 3. Identity-Aware Proxy (IAP) & Domain Access
# ------------------------------------------------------------------------------
# Custom domain name for JupyterHub (leave empty to auto-use <IP>.nip.io)
DOMAIN=""

# Google Group for enrolled students (e.g. group:students@your-university.edu)
STUDENT_GROUP=""

# Google Group for course Teaching Assistants (e.g. group:tas@your-university.edu)
TA_GROUP=""

# Space or comma-separated list of Admin user accounts (e.g. user:prof@your-university.edu)
ADMIN_USERS=""

# Idle Culler: When false, admin servers (e.g. amorbar, staff) are exempt from idle timeout and maxAge culling
CULL_ADMIN_USERS="false"

# Space or comma-separated list of individual test accounts
TEST_ACCOUNTS=""

# ------------------------------------------------------------------------------
# 4. Accelerator & Shared Python Environment
# ------------------------------------------------------------------------------
# GKE TPU accelerator label (default: v5e single chip 'tpu-v5-lite-podslice')
# For v6e: 'tpu-v6e-slice' | For v4: 'tpu-v4-podslice'
TPU_ACCELERATOR="tpu-v5-lite-podslice"

# TPU Topology (default: 1x1 single chip)
TPU_TOPOLOGY="1x1"

# Base image the course TPU job image (docker/tpu-job) is built FROM
TPU_IMAGE="us-docker.pkg.dev/cloud-tpu-images/jax-ai-image/tpu:latest"

# Base singleuser notebook container image (upstream image + live shared env on /tartan/11785/envs/)
SINGLEUSER_IMAGE="quay.io/jupyter/scipy-notebook"
SINGLEUSER_IMAGE_TAG="2024-11-11"
SHARED_ENV_NAME="idlf26jax"
REQUIREMENTS_FILE="requirements.txt"
SHARED_ENV_DIR="/tartan/11785/envs/${SHARED_ENV_NAME}"

# Sizing for the ephemeral batch environment builder job (make shared-env)
# (gke-gcsfuse-sidecar requests 5Gi, so 5Gi builder + 5Gi sidecar = 10Gi Autopilot pod max)
ENV_BUILDER_CPU="2"
ENV_BUILDER_MEMORY="8Gi"
ENV_BUILDER_STORAGE="5Gi"

# ------------------------------------------------------------------------------
# 5. Course Storage & TPU Job Submission (make storage, make shared-env, make hub)
# ------------------------------------------------------------------------------
# Shared Tartan store mounted at /tartan/11785 and /ocean (read-only for students & TPU jobs,
# read-write for staff and make shared-env). Holds datasets, shared Python envs, and assignments.
TARTAN_BUCKET="your-gcp-project-id-tartan"
TARTAN_URI="gs://${TARTAN_BUCKET}"
TARTAN_MOUNT_PATH="/tartan/11785"

# Private bucket for student job snapshots, logs, and checkpoints.
# Only the tpu-submit service can read or write here; students stay isolated in users/<name>/.
STUDENT_BUCKET="your-gcp-project-id-tpu-runs"

# Bucket where dataset .tar archives are stored (defaults to TARTAN_BUCKET).
DATASET_BUCKET="${TARTAN_BUCKET}"

# Dataset archives students can pick with submit(dataset=...). name=gs://... pairs,
# comma-separated. scripts/12_setup_storage.sh upload prints the line to paste here.
DATASETS=""
DEFAULT_DATASET=""

# Longest a single job may run. Kueue queue time does not count.
MAX_JOB_HOURS=8

# Chip-hours each student may use in total. 0 turns the limit off.
CHIP_HOUR_BUDGET=0

# Local disk for each job: unpacked dataset plus checkpoints.
JOB_DISK="100Gi"

# Delete job files (checkpoints, logs) from STUDENT_BUCKET after this many days.
RUNS_RETENTION_DAYS=120

# Optional cluster-level fallback Secret name (scripts/12_create_secrets.sh)
SECRET_NAME="course-secrets"
